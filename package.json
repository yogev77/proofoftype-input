  "license": "MIT",
  "type": "module",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./server.mjs" },
    "./server": { "types": "./index.d.ts", "default": "./server.mjs" },
    "./react": "./react.jsx",
    "./sdk": "./sdk/v1.js"
  },
  "types": "./index.d.ts",
  "files": ["sdk/", "server.mjs", "react.jsx", "index.d.ts", "README.md", "LICENSE", "CHANGELOG.md"],
  "peerDependencies": { "react": ">=17" },
